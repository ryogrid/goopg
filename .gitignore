# Ralph generated files (inside .ralph/ subfolder)
.ralph/.call_count
.ralph/.last_reset
.ralph/.exit_signals
.ralph/status.json
.ralph/.ralph_session
.ralph/.ralph_session_history
.ralph/.claude_session_id
.ralph/.devin_session_id
.ralph/.response_analysis
.ralph/.circuit_breaker_state
.ralph/.circuit_breaker_history
.ralph/.loop_start_sha
.ralph/.token_count

# Ralph logs and generated docs
.ralph/logs/*
!.ralph/logs/.gitkeep
.ralph/docs/generated/*
!.ralph/docs/generated/.gitkeep

# General logs
*.log

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
.temp/

# Go build artifacts
/bin/
/dist/
# Stray binary that `go build ./...` drops at repo root.
/goopg
*.test
*.out
coverage.txt
coverage.html

# Read-only upstream PostgreSQL reference clone — not part of goopg's codebase.
# See .ralph/specs/GOAL_AND_REQUIREMENTS.md §2.
/postgres/

# HammerDB benchmark binaries / source — fetched on demand, not part of goopg.
/HammerDB-5.0/
/HammerDB-5.0-Prod-Lin-UBU22.tar.gz
/HammerDB/

# Ephemeral state created by bench/tpch scripts (PGDATA, sockets, HammerDB tmp).
/bench/tpch/runtime/
/bench/tpch/logs/

# Local dev data directories
/tmp-data/
/var/

# IDE / editor
.gopls/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Ralph backup directories (created by migration)
.ralph_backup_*
.aider*

# Python virtual environment
venv/
tmp/
pprof-data/

config.json
create_pg_super_document/
serena/

# Claude Code worktree directories — git worktrees, not project source.
.claude/worktrees/

# Serena MCP tooling state (project metadata + per-project memories).
.serena/

# Scratch tree-dump from exploration tools.
code_tree.txt

# Stray `go build ./cmd/validate-ralph-state` output at repo root. The
# Makefile guard uses `go run`, so this compiled binary is pure junk; a prior
# loop left a 3.2 MB ELF here that polluted `git status` and risked an
# accidental commit. Ignore it (root-anchored so it never masks the cmd/ pkg).
/validate-ralph-state

# TPC-H goopg runtime artifacts (PostgreSQL data dir, pid, logs) — must never be committed.
bench/tpch/runtime_goopg/data/
bench/tpch/runtime_goopg/*.pid
bench/tpch/runtime_goopg/*.log
bench/tpch/runtime_goopg/tmp/
bench/tpch/runtime_goopg/preloss-clone-*/
bench/tpch/runtime_goopg/evidence-*/
bench/tpch/runtime_goopg/tpch-golden-*/
bench/tpch/runtime_goopg/*.HOLD
bench/tpch/runtime_goopg/goopg-bin

# TPC-DS runtime artifacts (bench/tpcds/ — clusters, TSVs, results, logs).
# The ONE tracked exception is the pinned SF0.5 row-count oracle, which lets
# other machines/CI run the goopg sweep without a PostgreSQL instance
# (see bench/tpcds/README.md "SF 0.5 fast regression gate").
bench/tpcds/runtime/
bench/tpcds/runtime_goopg/data/
bench/tpcds/runtime_goopg/data-sf05/
bench/tpcds/runtime_goopg/tpcds-data/
bench/tpcds/runtime_goopg/tpcds-data-sf05/
bench/tpcds/runtime_goopg/tpcds-results/
bench/tpcds/runtime_goopg/tpcds-results-sf05/*
!bench/tpcds/runtime_goopg/tpcds-results-sf05/oracle.txt
bench/tpcds/runtime_goopg/*.pid
bench/tpcds/runtime_goopg/*.log

# Nightly CI batch run outputs (ci/design/04)
ci/logs/
/__pycache__/
*.pyc

!ci/logs
# `ci/logs/*` below already covers the harness audit logs
# (precommit-skips.log, ralph-guard-denials.log, gate-exception-usage.log):
# they are machine-appended run state, never committed.
ci/logs/*
!ci/logs/action-items.md
!ci/logs/launch.log
!ci/logs/scheduler.log
!ci/logs/history.jsonl

analysis/tpcds-sf1-all-queries.md
*.pb.gz

# goopg-authored isolation specs + their PG-captured expected output. The
# oracle's own .spec/.out live under /postgres/ (a gitignored reference clone);
# these are goopg's committed fixtures. The *.out rule above would otherwise
# swallow the expected files, so re-include them here.
!internal/testport/expected/*.out

# goyacc debug artifacts (regenerated by make gen-parser)
internal/sqlparser/y.output
internal/sqlparser/yacc_stderr.txt

!opencode.json
# Mermaid validator
tools/mermaid-validator/node_modules/

# Plan-parity harness (M0137–M0145): scratch must not live at the repo root.
# `bak/` once held a `package executor` test file at the root and broke
# `go vet ./...` for 10 hours while five tasks accepted the red as
# "pre-existing". Scratch belongs in analysis/m01NN/ — see AGENT.md
# §"Plan-parity harness" → "Working-directory hygiene".
/bak/
/estimate-audit
