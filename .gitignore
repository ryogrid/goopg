# Ralph generated files (inside .ralph/ subfolder)
.ralph/.call_count
.ralph/.last_reset
.ralph/.exit_signals
.ralph/status.json
.ralph/.ralph_session
.ralph/.ralph_session_history
.ralph/.claude_session_id
.ralph/.response_analysis
.ralph/.circuit_breaker_state
.ralph/.circuit_breaker_history
.ralph/.loop_start_sha
.ralph/.token_count

# Ralph logs and generated docs
.ralph/logs/*
!.ralph/logs/.gitkeep
.ralph/docs/generated/*
!.ralph/docs/generated/.gitkeep

# General logs
*.log

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
.temp/

# Go build artifacts
/bin/
/dist/
/goopg            # stray binary `go build ./...` drops at repo root
*.test
*.out
coverage.txt
coverage.html

# Read-only upstream PostgreSQL reference clone — not part of goopg's codebase.
# See .ralph/specs/GOAL_AND_REQUIREMENTS.md §2.
/postgres/

# HammerDB benchmark binaries / source — fetched on demand, not part of goopg.
/HammerDB-5.0/
/HammerDB-5.0-Prod-Lin-UBU22.tar.gz
/HammerDB/

# Ephemeral state created by bench/tpch scripts (PGDATA, sockets, HammerDB tmp).
/bench/tpch/runtime/
/bench/tpch/logs/

# Local dev data directories
/tmp-data/
/var/

# IDE / editor
.gopls/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Ralph backup directories (created by migration)
.ralph_backup_*
.aider*

config.json
