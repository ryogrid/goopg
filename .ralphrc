# .ralphrc - Ralph project configuration
# Generated by: ralph-setup
# Documentation: https://github.com/frankbria/ralph-claude-code

# Project identification
PROJECT_NAME="goopg"
PROJECT_TYPE="generic"

# Claude Code CLI command
# If "claude" is not in your PATH, set to your installation:
#   "npx @anthropic-ai/claude-code"  (uses npx, no global install needed)
#   "/path/to/claude"                (custom path)
#CLAUDE_CODE_CMD="claude"

# Loop settings
MAX_CALLS_PER_HOUR=100
CLAUDE_TIMEOUT_MINUTES=1440
CLAUDE_OUTPUT_FORMAT="json"
# Token limit per hour (0 = disabled). One invocation can use 100k+ tokens.
# Recommended: 500000 for light use, 2000000 for heavy use.
#MAX_TOKENS_PER_HOUR=0

# Tool permissions
# Comma-separated list of allowed tools
# Safe git subcommands only - keep this list minimal and avoid destructive commands
# kaizen H3 (2026-06-04): added the newer built-in tools the loop routinely calls
# but were previously denied — ToolSearch/TodoWrite/Task*/Glob/Agent/Monitor/
# ScheduleWakeup accounted for the 437 permission-denial loops in the log history.
# kaizen (2026-06-11): added mcp__any-script__* — the pg_* symbol tools (search/
# source/references over the read-only ./postgres oracle tree) are registered at
# user scope but were permission-denied inside the loop, forcing slower
# grep/global exploration of PG internals.
# cost-optimization (2026-08-14): added SendMessage,ListAgents — the coordinator
# edition PROMPT.md drives multi-round worker conversations via SendMessage; a
# denial would silently break the delegation protocol (same failure class as H3).
ALLOWED_TOOLS="Write,Read,Edit,Grep,Bash(grep *),Bash(*),Bash(git add *),Bash(git commit *),Bash(git diff *),Bash(git log *),Bash(git status),Bash(git status *),Bash(git push *),Bash(git pull *),Bash(git fetch *),Bash(git branch *),Bash(git tag *),Bash(go *),Bash(make *),Bash(gofmt *),Bash(rg *),Bash(psql *),Bash(pgbench *),Bash(npm *),Bash(pytest),ToolSearch,TodoWrite,TaskCreate,TaskUpdate,TaskGet,TaskList,Glob,Agent,SendMessage,ListAgents,Monitor,ScheduleWakeup,mcp__serena__*,mcp__any-script__*"

# Session management
SESSION_CONTINUITY=true
SESSION_EXPIRY_HOURS=24

# Task sources (for ralph enable --sync)
# Options: local, beads, github (comma-separated for multiple)
TASK_SOURCES="local"
GITHUB_TASK_LABEL="ralph-task"
BEADS_FILTER="status:open"

# Circuit breaker thresholds
# kaizen H4 (2026-06-04): SAME_ERROR was effectively disabled at 1000 so the breaker
# never caught repeated-failure storms (it only ever tripped on permission denials,
# now commented out in lib/circuit_breaker.sh). Restore the lib default (5) as a
# backstop now that the driver's 429 retry-storm cause is fixed (kaizen H1).
# OUTPUT_DECLINE is a PERCENT (lib default 70); currently defined but unused by the
# breaker logic — set to the sensible default for when it is implemented.
CB_NO_PROGRESS_THRESHOLD=3
CB_SAME_ERROR_THRESHOLD=5
CB_OUTPUT_DECLINE_THRESHOLD=70
# Auto-update Claude CLI at startup
CLAUDE_AUTO_UPDATE=true

# Shell init file (optional)
# Source this file before running claude — useful when claude requires environment
# variables or PATH entries defined in a non-bash shell config (e.g. ~/.zshrc).
# Leave commented out unless needed.
#RALPH_SHELL_INIT_FILE="~/.zshrc"

# kaizen (2026-07-06): headless -p mode kills run_in_background tasks ~5s after
# the final result, so test gates MUST run in the FOREGROUND. Raise the Bash
# tool timeouts for loop sessions only (this file is sourced by ralph_loop.sh, so
# the exports reach the claude child). Interactive sessions get only the ceiling
# via .claude/settings.local.json "env". See "Headless Execution Reality" in
# .ralph/PROMPT.md and analysis/ralph-loop-kaizen/practice-cards/bg_task_guard.py.
export BASH_DEFAULT_TIMEOUT_MS=900000    # 15 min default per Bash call
export BASH_MAX_TIMEOUT_MS=3600000       # 60 min ceiling (race-gate + spotcheck)
