diff --git a/internal/optimizer/zz_dupkey_probe.go b/internal/optimizer/zz_dupkey_probe.go
new file mode 100644
index 000000000..a913a552b
--- /dev/null
+++ b/internal/optimizer/zz_dupkey_probe.go
@@ -0,0 +1,123 @@
+package optimizer
+
+// TEMPORARY PROBE (M0145-0026 recon) — not for commit.
+
+import (
+	"fmt"
+	"runtime/debug"
+	"os"
+	"reflect"
+	"strings"
+
+	"github.com/goopg/goopg/internal/parser"
+)
+
+var zzDupKeyOn = os.Getenv("GOOPG_TMP_DUPKEY") == "1"
+
+func zzDeep(b *strings.Builder, v reflect.Value, depth int) {
+	if depth > 25 {
+		b.WriteString("...")
+		return
+	}
+	switch v.Kind() {
+	case reflect.Invalid:
+		b.WriteString("nil")
+	case reflect.Ptr, reflect.Interface:
+		if v.IsNil() {
+			b.WriteString("nil")
+			return
+		}
+		zzDeep(b, v.Elem(), depth+1)
+	case reflect.Struct:
+		b.WriteString(v.Type().Name() + "{")
+		for i := 0; i < v.NumField(); i++ {
+			if v.Type().Field(i).Name == "pos" {
+				continue
+			}
+			zzDeep(b, v.Field(i), depth+1)
+			b.WriteString(",")
+		}
+		b.WriteString("}")
+	case reflect.Slice, reflect.Array:
+		b.WriteString("[")
+		for i := 0; i < v.Len(); i++ {
+			zzDeep(b, v.Index(i), depth+1)
+			b.WriteString(",")
+		}
+		b.WriteString("]")
+	case reflect.Map:
+		b.WriteString("map")
+	default:
+		fmt.Fprintf(b, "%v", v)
+	}
+}
+
+func zzS(e Expr) string { var b strings.Builder; zzDeep(&b, reflect.ValueOf(e), 0); return b.String() }
+
+func zzDupKeyProbe(site string, keys []*restrictInfo, jt parser.JoinType) {
+	if !zzDupKeyOn {
+		return
+	}
+	var ps []JoinKeyPair
+	for _, k := range keys {
+		ps = append(ps, JoinKeyPair{Left: k.leftKey, Right: k.rightKey})
+	}
+	zzDupPairs(site, ps, fmt.Sprint(jt))
+	if len(keys) == 3 && jt == parser.JoinAnti {
+		for i, k := range keys {
+			fmt.Fprintf(os.Stderr, "ZZKEY site=%s i=%d inferred=%v ec=%d relids=%v clause=%p l=%.160s r=%.160s c=%.300s\n", site, i, k.inferred, k.ecID, k.relids, k.clause, zzS(k.leftKey), zzS(k.rightKey), zzS(k.clause))
+		}
+	}
+}
+
+func zzDupPairs(site string, ps []JoinKeyPair, jt string) {
+	if !zzDupKeyOn {
+		return
+	}
+	seen := map[string]int{}
+	for i, p := range ps {
+		k := zzS(p.Left) + "|" + zzS(p.Right)
+		if j, ok := seen[k]; ok {
+			fmt.Fprintf(os.Stderr, "ZZDUP site=%s jt=%s n=%d i=%d j=%d key=%.300s\n", site, jt, len(ps), i, j, k)
+			return
+		}
+		seen[k] = i
+	}
+	if site != "" {
+		fmt.Fprintf(os.Stderr, "ZZOK site=%s jt=%s n=%d\n", site, jt, len(ps))
+	}
+}
+
+func zzJT(t JoinType) string { return fmt.Sprint(t) }
+
+func zzConjProbe(conj []Expr, inferred int) {
+	if !zzDupKeyOn {
+		return
+	}
+	seen := map[string]int{}
+	for i, c := range conj {
+		b, ok := c.(*BinaryOp)
+		if !ok || b.Op != parser.OpEq {
+			continue
+		}
+		fwd, rev := zzS(b.Left)+"="+zzS(b.Right), zzS(b.Right)+"="+zzS(b.Left)
+		if j, ok := seen[rev]; ok && fwd != rev {
+			fmt.Fprintf(os.Stderr, "ZZCONJ n=%d inferred=%d i=%d j=%d samePtr=%v fwd=%.200s\n%s\n", len(conj), inferred, i, j, conj[j] == c, fwd, debug.Stack())
+			return
+		}
+		seen[fwd] = i
+	}
+}
+
+func zzSeg(tag string, cs []Expr) {
+	if !zzDupKeyOn {
+		return
+	}
+	for _, c := range cs {
+		if b, ok := c.(*BinaryOp); ok && b.Op == parser.OpEq {
+			if l, ok := b.Left.(*ColumnRef); ok && strings.Contains(l.Name, "order_number") {
+				fmt.Fprintf(os.Stderr, "ZZSEG %s %s=%s\n", tag, l.Name, zzS(b.Right))
+			}
+		}
+	}
+}
