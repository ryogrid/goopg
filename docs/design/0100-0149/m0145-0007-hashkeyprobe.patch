diff --git a/internal/optimizer/zz_hashkeyprobe.go b/internal/optimizer/zz_hashkeyprobe.go
new file mode 100644
index 000000000..250d97515
--- /dev/null
+++ b/internal/optimizer/zz_hashkeyprobe.go
@@ -0,0 +1,159 @@
+package optimizer
+
+// TEMPORARY PROBE (M0145-0007 slice 5 adjudication) — not for commit.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"strings"
+	"sync"
+)
+
+var hkProbeOn = os.Getenv("GOOPG_HASHKEY_PROBE") == "1"
+
+type hkProbeRec struct {
+	live []JoinKeyPair
+	snap string
+	pred string
+}
+
+var hkProbeMap sync.Map
+var hkFillMap sync.Map
+
+func hkExprStr(e Expr) string {
+	switch x := e.(type) {
+	case nil:
+		return "nil"
+	case *ColumnRef:
+		return fmt.Sprintf("c%d:%s", x.Index, x.Name)
+	case *OuterColumnRef:
+		return fmt.Sprintf("o%+v", *x)
+	default:
+		var b strings.Builder
+		hkDeep(&b, reflect.ValueOf(e), 0)
+		return b.String()
+	}
+}
+
+func hkDeep(b *strings.Builder, v reflect.Value, depth int) {
+	if depth > 30 {
+		b.WriteString("...")
+		return
+	}
+	switch v.Kind() {
+	case reflect.Invalid:
+		b.WriteString("nil")
+	case reflect.Ptr, reflect.Interface:
+		if v.IsNil() {
+			b.WriteString("nil")
+			return
+		}
+		hkDeep(b, v.Elem(), depth+1)
+	case reflect.Struct:
+		b.WriteString(v.Type().Name() + "{")
+		for i := 0; i < v.NumField(); i++ {
+			f := v.Type().Field(i)
+			if f.Name == "pos" {
+				continue
+			}
+			b.WriteString(f.Name + ":")
+			hkDeep(b, v.Field(i), depth+1)
+			b.WriteString(" ")
+		}
+		b.WriteString("}")
+	case reflect.Slice, reflect.Array:
+		b.WriteString("[")
+		for i := 0; i < v.Len(); i++ {
+			hkDeep(b, v.Index(i), depth+1)
+			b.WriteString(",")
+		}
+		b.WriteString("]")
+	case reflect.Map:
+		b.WriteString(fmt.Sprintf("map#%d", v.Len()))
+	case reflect.Func, reflect.Chan, reflect.UnsafePointer:
+		b.WriteString(v.Kind().String())
+	default:
+		b.WriteString(fmt.Sprint(v.Interface()))
+	}
+}
+
+func hkPairsStr(ps []JoinKeyPair) string {
+	var b strings.Builder
+	for i, p := range ps {
+		if i > 0 {
+			b.WriteString(",")
+		}
+		b.WriteString(hkExprStr(p.Left) + "=" + hkExprStr(p.Right))
+	}
+	return b.String()
+}
+
+func hkProbeRecord(j *Join) {
+	if !hkProbeOn {
+		return
+	}
+	r := &hkProbeRec{live: j.HashKeys, snap: hkPairsStr(j.HashKeys)}
+	hkProbeMap.Store(j, r)
+	if len(j.HashKeys) > 0 {
+		hkProbeMap.Store(&j.HashKeys[0], r)
+	}
+}
+
+// hkProbeCompare runs inside fillOneJoinHashKeys BEFORE it overwrites.
+func hkProbeCompare(j *Join, before []JoinKeyPair, after []JoinKeyPair) {
+	if !hkProbeOn || (j.Algo != JoinAlgoHash && j.Algo != JoinAlgoMerge) {
+		return
+	}
+	v, ok := hkProbeMap.Load(j)
+	origin := "lowering"
+	if !ok && len(before) > 0 {
+		v, ok = hkProbeMap.Load(&before[0])
+		origin = "lowering-copied"
+	}
+	if !ok && len(before) > 0 {
+		if _, rv := hkFillMap.Load(&before[0]); rv {
+			origin = "revisit"
+			if len(after) > 0 {
+				hkFillMap.Store(&after[0], true)
+			}
+			fmt.Fprintf(os.Stderr, "HASHKEYPROBE origin=revisit algo=%d type=%d same=%v\n", j.Algo, j.Type, hkPairsStr(before) == hkPairsStr(after))
+			return
+		}
+	}
+	if len(after) > 0 {
+		hkFillMap.Store(&after[0], true)
+	}
+	if !ok {
+		fmt.Fprintf(os.Stderr, "HASHKEYPROBE origin=nonlowering algo=%d type=%d n=%d before=%d site=%v\n", j.Algo, j.Type, len(after), len(before), hkSite(j))
+		return
+	}
+	r := v.(*hkProbeRec)
+	liveNow := hkPairsStr(r.live)
+	fill := hkPairsStr(after)
+	mutated := liveNow != r.snap
+	verdict := "same"
+	if liveNow != fill {
+		verdict = "DIFF"
+		if len(r.live) != len(after) {
+			verdict = "DIFFLEN"
+		}
+	}
+	fmt.Fprintf(os.Stderr, "HASHKEYPROBE origin=%s algo=%d type=%d verdict=%s mutated=%v fold=[%s] fill=[%s] snap=[%s]\n",
+		origin, j.Algo, j.Type, verdict, mutated, liveNow, fill, r.snap)
+}
+
+var hkTagMap sync.Map
+
+func hkProbeTag(j *Join, site string) {
+	if hkProbeOn {
+		hkTagMap.Store(j, site)
+	}
+}
+
+func hkSite(j *Join) string {
+	if v, ok := hkTagMap.Load(j); ok {
+		return v.(string)
+	}
+	return "untagged"
+}
