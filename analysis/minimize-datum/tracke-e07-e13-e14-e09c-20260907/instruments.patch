--- internal/executor/zz_e13_census.go
package executor

// zz_e13_census.go — TEMPORARY measurement instrument for E-13 (EX1-04 Cut 2)
// and E-14 (Cut A/B). NOT for commit.
//
// E-13's gate is "only if a later alloc arm shows a residual". The residual it
// would collect is, at each RETAINING site (hash build, sort input), the
// columns beyond the threaded EX1-01 deform bound: `(width - bound) * 48 B`
// per retained row. This instrument records (width, bound) at Build and the
// retained row count at run, so the residual is a product of measured numbers
// rather than an argument.

import (
	"fmt"
	"os"
	"sync"

	"github.com/goopg/goopg/internal/optimizer"
)

var censusOn = os.Getenv("GOOPG_E13_CENSUS") != ""

var censusMu sync.Mutex

func censusLogf(format string, args ...any) {
	if !censusOn {
		return
	}
	censusMu.Lock()
	defer censusMu.Unlock()
	fmt.Fprintf(os.Stderr, "E13CENSUS "+format+"\n", args...)
}

// censusBuildSite records a retaining Build site's schema width against the
// bound its child subtree was built with.
func censusJoinSite(p *optimizer.Join, leftBound, rightBound int) {
	if !censusOn {
		return
	}
	buildLeft := p.BuildLeft
	if p.Type == optimizer.JoinTypeSemi || p.Type == optimizer.JoinTypeAnti {
		buildLeft = false
	}
	w, b := len(p.Right.Output()), rightBound
	if buildLeft {
		w, b = len(p.Left.Output()), leftBound
	}
	censusLogf("join algo=%v type=%v buildLeft=%v buildWidth=%d buildBound=%d node=%p",
		p.Algo, p.Type, buildLeft, w, b, p)
}

func censusSortSite(p *optimizer.Sort, childBound int) {
	if !censusOn {
		return
	}
	censusLogf("sort childWidth=%d childBound=%d node=%p", len(p.Child.Output()), childBound, p)
}

func censusSortRetained(p *optimizer.Sort, n int64, w int) {
	if !censusOn || n == 0 {
		return
	}
	censusLogf("sort-retained node=%p rows=%d width=%d", p, n, w)
}

func censusRetained(p *optimizer.Join, n int64, w int) {
	if !censusOn || n == 0 {
		return
	}
	censusLogf("join-retained node=%p rows=%d width=%d", p, n, w)
}
--- internal/executor/zz_e09c_stall.go
package executor

// zz_e09c_stall.go — TEMPORARY measurement instrument for E-09c
// ("cooperative-stall measurement under skew + worker-count scaling").
// NOT for commit.
//
// The cooperative parallel hash build (parallel_hash_build.go) is a
// producer/consumer split: N producers scan+filter and send 256-row batches
// through a depth-limited channel; ONE consumer (the leader) evaluates keys
// and inserts. Either half can stall on the other. This instrument charges
// the blocked time to whichever side actually waited:
//
//   producerBlockedNs — summed across producers, time parked on `ch <- batch`
//                       (the consumer is the bottleneck)
//   consumerBlockedNs — time the leader parked on `<-ch` with the channel
//                       empty (the producers are the bottleneck)
//
// A cooperative build with NO stall shows both near zero relative to build
// wall time.

import (
	"fmt"
	"os"
	"sync/atomic"
	"time"
)

var stallOn = os.Getenv("GOOPG_E09C_STALL") != ""

var (
	stallProducerNs atomic.Int64
	stallConsumerNs atomic.Int64
	stallBatches    atomic.Int64
	stallRecvWaits  atomic.Int64
)

func stallAddProducer(d time.Duration) {
	stallProducerNs.Add(int64(d))
	stallBatches.Add(1)
}

func stallAddConsumer(d time.Duration) {
	stallConsumerNs.Add(int64(d))
	stallRecvWaits.Add(1)
}

func stallReport(tag string, buildWall time.Duration, producers int) {
	if !stallOn {
		return
	}
	p := stallProducerNs.Swap(0)
	c := stallConsumerNs.Swap(0)
	b := stallBatches.Swap(0)
	w := stallRecvWaits.Swap(0)
	fmt.Fprintf(os.Stderr,
		"E09CSTALL %s producers=%d buildWallMs=%.1f producerBlockedMs=%.1f consumerBlockedMs=%.1f batches=%d recvWaits=%d\n",
		tag, producers, float64(buildWall)/1e6, float64(p)/1e6, float64(c)/1e6, b, w)
}
--- internal/executor/zz_e09c_scaling_test.go
package executor

// zz_e09c_scaling_test.go — TEMPORARY measurement harness for E-09c
// ("Cooperative-stall measurement under skew + worker-count scaling on
// Q9-class shapes"). NOT for commit.
//
// Run with:
//   GOOPG_E09C_STALL=1 go test -run TestE09CStallScaling -v ./internal/executor/
//
// It drives the COOPERATIVE PARALLEL HASH BUILD (parallel_hash_build.go) —
// N producers scan+filter, one consumer inserts — across worker counts and
// two build-key distributions (uniform vs 10:1 skew), and reads the
// producer/consumer blocked-time counters from zz_e09c_stall.go.

import (
	"fmt"
	"os"
	"strings"
	"testing"
	"time"
)

func e09cSeed(t *testing.T, ctx *Context, table string, n int, skew bool) {
	t.Helper()
	const batch = 500
	for base := 0; base < n; base += batch {
		var sb strings.Builder
		sb.WriteString("INSERT INTO " + table + " VALUES ")
		for i := base; i < base+batch && i < n; i++ {
			if i > base {
				sb.WriteString(",")
			}
			k := i
			if skew {
				// 90% of build rows collapse onto 1/10 of the key space:
				// the consumer's bucket chains lengthen while the producers'
				// scan cost is unchanged.
				if i%10 != 0 {
					k = i % (n / 10)
				}
			}
			fmt.Fprintf(&sb, "(%d,'name-%06d')", k, i)
		}
		if err := runDDL(t, ctx, sb.String()); err != nil {
			t.Fatalf("seed %s: %v", table, err)
		}
	}
}

func TestE09CStallScaling(t *testing.T) {
	if os.Getenv("GOOPG_E09C_STALL") == "" {
		t.Skip("measurement harness; set GOOPG_E09C_STALL=1")
	}
	// The BUILD side is the SMALLER input, so the probe table must be
	// larger than the table whose build we want to measure.
	const dimRows = 300000
	const factRows = 330000

	for _, skew := range []bool{false, true} {
		for _, workers := range []int{2, 4, 8} {
			name := fmt.Sprintf("skew=%v/workers=%d", skew, workers)
			t.Run(name, func(t *testing.T) {
				ctx, _, cleanup := newDDLFixture(t)
				defer cleanup()
				if err := runDDL(t, ctx, "CREATE TABLE cs_dim (dk int, dname text)"); err != nil {
					t.Fatal(err)
				}
				if err := runDDL(t, ctx, "CREATE TABLE cs_fact (fid int, fk int)"); err != nil {
					t.Fatal(err)
				}
				e09cSeed(t, ctx, "cs_dim", dimRows, skew)
				// Probe side is the LARGER input so the planner builds on cs_dim.
				for base := 0; base < factRows; base += 500 {
					var sb strings.Builder
					sb.WriteString("INSERT INTO cs_fact VALUES ")
					for i := base; i < base+500 && i < factRows; i++ {
						if i > base {
							sb.WriteString(",")
						}
						fmt.Fprintf(&sb, "(%d,%d)", i, i%dimRows)
					}
					if err := runDDL(t, ctx, sb.String()); err != nil {
						t.Fatal(err)
					}
				}

				ctx.MaxParallelWorkers = workers
				ctx.MinParallelTableScanBlocks = 1
				ctx.ParallelLeaderParticipation = true
				ctx.WorkMem = 1 << 30 // single batch: the coop path declines when NBatch > 1

				start := time.Now()
				rows, err := runQueryWithErr(ctx,
					"SELECT count(*) FROM cs_fact f JOIN cs_dim d ON f.fk = d.dk")
				if err != nil {
					t.Fatalf("query: %v", err)
				}
				t.Logf("E09C %s wall=%.1fms rows=%v", name, float64(time.Since(start))/1e6, renderRows(rows))
			})
		}
	}
}
