+	if err != nil {
+		t.Fatal(err)
+	}
+	// file -> enclosing function names calling defaultCostParams().
+	found := map[string][]string{}
+	fset := token.NewFileSet()
+	for _, e := range entries {
+		name := e.Name()
+		if !strings.HasSuffix(name, ".go") || strings.HasSuffix(name, "_test.go") {
+			continue
