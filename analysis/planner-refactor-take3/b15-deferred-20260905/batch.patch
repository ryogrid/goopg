+	tiny := base
+	tiny.selectivity = 1e-9 // raw 1e-5 tuples -> rint -> 0 -> clamp 1
+	_, totTiny := btreeIndexAMCost(cp, tiny)
+	oneTuple := base
+	oneTuple.selectivity = 1.0 / 10000 // raw exactly 1
+	_, totOne := btreeIndexAMCost(cp, oneTuple)
+	if math.Abs(totTiny-totOne) > 1e-9 {
+		t.Errorf("sub-tuple total = %v, want single-tuple total %v (lower clamp)", totTiny, totOne)
+	}
+
+	// The upper clamp: selectivity above 1 (or a bloated estimate) never
+	// exceeds the index's own tuple count.
+	big := base
+	big.selectivity = 5.0 // raw 50000 > 10000 index tuples
+	_, totBig := btreeIndexAMCost(cp, big)
+	full := base
+	full.selectivity = 1.0
+	_, totFull := btreeIndexAMCost(cp, full)
+	if math.Abs(totBig-totFull) > 1e-9 {
+		t.Errorf("over-index total = %v, want full-index total %v (upper clamp)", totBig, totFull)
+	}
+}
+
+// B-15 R5: the repeated-scan page arm (`genericcostestimate`, :7181-7201) —
+// `num_scans = num_sa_scans * loop_count > 1` runs Mackert-Lohman over the
+// total touches and pro-rates by the OUTER scans only. The loop-only case
+// (no SAOP) is the NLI-inner shape: ML(numPages*L)/L <= numPages, so a
+// re-executed probe's index pages cost LESS than L times one execution.
+func TestBtreeRepeatedScanMLBranch(t *testing.T) {
+	cp := defaultCostParams()
+	base := indexScanInputs{
+		relPages: 100, relTuples: 10000, indexPages: 90, indexTuples: 10000,
+		treeHeight: 2, selectivity: 0.01, totalTablePages: 200,
+	}
+	_, totSingle := btreeIndexAMCost(cp, base)
+	// Loop-only: per-scan pages ceil(100*90/10000) = 1; ML(1*5) over a
+	// 90-page index with a huge cache share: 2*90*5/(180+5) = 900/185 =
+	// 4.86 -> ceil 5; pro-rated 5/5 = 1 page. Same single page here (the
+	// discount bites on larger touches), but the branch must hold: total
+	// equals the single-scan page cost plus identical CPU.
+	looped := base
+	looped.loopCount = 5
+	_, totLooped := btreeIndexAMCost(cp, looped)
+	if math.Abs(totLooped-totSingle) > 1e-9 {
+		t.Errorf("looped total = %v, want single total %v (5/5 pro-rate is exact here)", totLooped, totSingle)
+	}
+	// A larger touch shows the sublinearity: selectivity 1.0 -> per-scan
+	// pages 90; ML(90*5=450, T=90): 2*90*450/(180+450) = 81000/630 =
+	// 128.57 >= T -> capped at 90; pro-rated 90/5 = 18 pages vs 90 single.
+	big := base
+	big.selectivity = 1.0
+	_, totBigSingle := btreeIndexAMCost(cp, big)
+	bigLooped := big
+	bigLooped.loopCount = 5
+	_, totBigLooped := btreeIndexAMCost(cp, bigLooped)
+	pages := indexPagesFetched(90*5, 90, 90, 200, cp.effectiveCacheSize)
+	if pages != 90 {
+		t.Fatalf("ML(90 pages x 5 scans) = %v, want 90 (capped at T)", pages)
+	}
+	wantPage := (pages / 5) * cp.randomPageCost * indexProbeCostMultiplier
+	singlePage := 90 * cp.randomPageCost * indexProbeCostMultiplier
+	if !(wantPage < singlePage) {
+		t.Fatalf("pro-rated pages %v not below single-scan %v — the ML arm is not sublinear", wantPage, singlePage)
+	}
+	// CPU is loop-invariant here (numSA=1, same tuples), so the delta is
+	// exactly the page delta.
+	if want := totBigSingle + (wantPage - singlePage); math.Abs(totBigLooped-want) > 1e-6 {
+		t.Errorf("big looped total = %v, want %v", totBigLooped, want)
+	}
+}
