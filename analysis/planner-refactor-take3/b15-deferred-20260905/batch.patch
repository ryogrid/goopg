diff --git a/internal/optimizer/costbitmap_test.go b/internal/optimizer/costbitmap_test.go
index 9f31eed2e..00c67f119 100644
--- a/internal/optimizer/costbitmap_test.go
+++ b/internal/optimizer/costbitmap_test.go
@@ -205,3 +205,40 @@ func TestCostBitmapHeapScan_SmallFraction(t *testing.T) {
 		t.Errorf("tiny fraction should have positive run cost")
 	}
 }
+
+// TestCostBitmapIndexScan_SAOPDivisionAndMLPassThrough pins that the bitmap
+// index side reads the SAME btreeIndexAMCost the plain scan reads (B-15 R3
+// division + R5 ML branch included): the bitmap SAOP total is the index-side
+// SAOP total plus the unchanged 0.1*cpu_operator_cost-per-tuple overhead.
+// Fixture: raw 100 tuples over 10 descents -> rint(100/10) = 10 per scan,
+// per-scan pages 1 -> ML(1*10) = 10 pages.
+func TestCostBitmapIndexScan_SAOPDivisionAndMLPassThrough(t *testing.T) {
+	cp := defaultCostParams()
+	in := indexScanInputs{
+		relPages: 100, relTuples: 10000,
+		indexPages: 90, indexTuples: 10000, treeHeight: 2,
+		selectivity: 0.01, correlation: 0, totalTablePages: 200,
+		numSAScans: 10,
+	}
+	idxStartup, idxTotal := btreeIndexAMCost(cp, in)
+	bitmap := costBitmapIndexScan(cp, in)
+	tuplesFetched := clampRowEst(in.selectivity * in.relTuples) // 100
+	overhead := 0.1 * cp.cpuOperatorCost * tuplesFetched        // 0.1 * 0.0025 * 100 = 0.025
+	if diff := bitmap.Total - idxTotal; math.Abs(diff-overhead) > 1e-9 {
+		t.Errorf("bitmap SAOP overhead over the divided index side = %v, want %v", diff, overhead)
+	}
+	if math.Abs(bitmap.Startup-idxStartup) > 1e-9 {
+		t.Errorf("bitmap SAOP startup = %v, want the index-side startup %v", bitmap.Startup, idxStartup)
+	}
+	// And the R1 qual term flows through identically: 2 quals add
+	// 10*10*2*cpu_operator_cost to both sides alike.
+	in.numIndexQuals = 2
+	qIdxStartup, qIdxTotal := btreeIndexAMCost(cp, in)
+	qBitmap := costBitmapIndexScan(cp, in)
+	if math.Abs(qBitmap.Total-qIdxTotal-overhead) > 1e-9 {
+		t.Errorf("qualed bitmap SAOP total = %v, want index side %v + overhead %v", qBitmap.Total, qIdxTotal, overhead)
+	}
+	if math.Abs(qBitmap.Startup-qIdxStartup) > 1e-9 {
+		t.Errorf("qualed bitmap SAOP startup = %v, want %v (quals add no startup)", qBitmap.Startup, qIdxStartup)
+	}
+}
