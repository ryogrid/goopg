+func spillPagesInner(rows float64, ncols int, avgVarBytes float64) float64 {
+	return spillPagesFor(rows, hashsize.SpillInnerBytes(ncols, avgVarBytes))
+}
+
+func spillPagesOuter(rows float64, ncols int, avgVarBytes float64) float64 {
+	return spillPagesFor(rows, hashsize.SpillBytes(ncols, avgVarBytes))
