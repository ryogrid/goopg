+
+// spillChargeAtEntryBytesModel reconstructs the EXTRA batch charge
+// `hashJoinCost` carried BEFORE spill-cost calibration Cut 3
+// (`docs/design/planner-spill-cost-calibration/DESIGN.md` §6.2) re-denominated
+// it from the in-memory `hashsize.EntryBytes` to the on-disk
+// `hashsize.SpillBytes` / `SpillInnerBytes` model.
+//
+// It exists so the two P4-01 witness tests keep pinning the historical claim
+// they were written for — the WIDE build priced above the merge bar, the
+// narrowed one below it — now that the wide build prices below the bar on the
+// derived model alone. Both facts stay asserted, and neither is a literal.
+func spillChargeAtEntryBytesModel(cp costParams, in hashJoinInputs) float64 {
+	if hashsize.Choose(in.innerRows, in.innerCols, in.innerAvgVarBytes, cp.workMem).NBatch <= 1 {
+		return 0
+	}
+	pages := func(rows float64, ncols int, avgVar float64) float64 {
+		if !(rows > 0) {
+			return 0
+		}
+		return math.Ceil(rows * hashsize.EntryBytes(ncols, avgVar) / blockSizeBytes)
+	}
+	oldInner := pages(in.innerRows, in.innerCols, in.innerAvgVarBytes)
+	oldOuter := pages(in.outerRows, in.outerCols, in.outerAvgVarBytes)
+	newInner := spillPagesInner(in.innerRows, in.innerCols, in.innerAvgVarBytes)
+	newOuter := spillPagesOuter(in.outerRows, in.outerCols, in.outerAvgVarBytes)
+	return cp.seqPageCost * ((2*oldInner + 2*oldOuter) - (2*newInner + 2*newOuter))
+}
diff --git a/internal/optimizer/spill_charge_test.go b/internal/optimizer/spill_charge_test.go
new file mode 100644
index 000000000..de87fd39c
--- /dev/null
+++ b/internal/optimizer/spill_charge_test.go
@@ -0,0 +1,113 @@
+package optimizer
+
+import (
+	"math"
+	"testing"
+
+	"github.com/goopg/goopg/internal/executor/hashsize"
+)
+
+// Spill-cost calibration Cut 3
+// (`docs/design/planner-spill-cost-calibration/DESIGN.md` §6.2): the hash
+// join's batch-file I/O charge is denominated in the ON-DISK byte model that
+// `internal/executor/spill.go` actually writes, not in the IN-MEMORY
+// `hashsize.EntryBytes`.
+//
+// These pin the three properties the design asks for, each through the named
+// model function rather than a literal page count — pinning the literal is
+// what hid an unapplied calibration for a release cycle (memory
+// `goopg_unapplied_calibration_constants`).
+
+// The two sides spill through different writers, so they must be charged
+// through different models: the inner (build) frame carries the canonical
+// hash-table key that E-14 added, the outer frame does not.
+func TestSpillPagesChargesEachSideThroughItsOwnWriterModel(t *testing.T) {
+	const rows, ncols = 500000.0, 8
+	const avgVar = 40.0
+
+	wantInner := math.Ceil(rows * hashsize.SpillInnerBytes(ncols, avgVar) / blockSizeBytes)
+	if got := spillPagesInner(rows, ncols, avgVar); got != wantInner {
+		t.Errorf("spillPagesInner = %v, want %v (hashsize.SpillInnerBytes)", got, wantInner)
+	}
+	wantOuter := math.Ceil(rows * hashsize.SpillBytes(ncols, avgVar) / blockSizeBytes)
+	if got := spillPagesOuter(rows, ncols, avgVar); got != wantOuter {
+		t.Errorf("spillPagesOuter = %v, want %v (hashsize.SpillBytes)", got, wantOuter)
+	}
+	// The keyed inner frame is strictly wider, and it is the drift the
+	// agreement test missed for a day when it pinned only one writer.
+	if !(spillPagesInner(rows, ncols, avgVar) > spillPagesOuter(rows, ncols, avgVar)) {
+		t.Errorf("inner batch pages %v not above outer %v — the keyed frame is unpriced",
+			spillPagesInner(rows, ncols, avgVar), spillPagesOuter(rows, ncols, avgVar))
+	}
+	if spillPagesInner(0, ncols, avgVar) != 0 || spillPagesOuter(-1, ncols, avgVar) != 0 {
+		t.Error("a zero/negative row count must charge nothing")
+	}
+}
+
+// The correction is a RATIO, not a constant: it is near 5x on a narrow
+// fixed-width row (where the 48-byte Datum is almost pure overhead) and near
+// 1x on a wide text row (where payload is carried at par on both sides). That
+// shape-dependence is precisely why Cut 3 is a derived second model and not the
+// scalar multiplier the item originally planned (DESIGN §6.2).
+func TestSpillChargeCorrectionIsShapeDependentNotAConstant(t *testing.T) {
+	ratio := func(ncols int, avgVar float64) float64 {
+		return hashsize.EntryBytes(ncols, avgVar) / hashsize.SpillBytes(ncols, avgVar)
+	}
+	narrow := ratio(9, 0)   // the Q14 phantom build
+	wide := ratio(2, 400.0) // wide text
+	if !(narrow > 4.0) {
+		t.Errorf("narrow fixed-width over-statement = %.2fx, want > 4x", narrow)
+	}
+	if !(wide < 1.5) {
+		t.Errorf("wide text over-statement = %.2fx, want < 1.5x", wide)
+	}
+	if !(narrow/wide > 3.0) {
+		t.Errorf("correction spans only %.2fx across shapes — a scalar multiplier would have sufficed and Cut 3's premise is refuted",
+			narrow/wide)
+	}
+}
+
+// §3.4, the load-bearing invariant: only the I/O CHARGE moves. The spill
+// DECISION stays on `hashsize.Choose`/`EntryBytes`, because that identity with
+// `joinOp.buildGeometry` is what makes `NBatch > 1` mean "the executor will
+// really write files". A calibration that leaked into the byte model would
+// desynchronise cost from executor — the defect the D-05 chain spent five
+// measurements locating.
+func TestCut3DoesNotMoveTheSpillDecision(t *testing.T) {
+	cp := defaultCostParams()
+	cp.workMem = 128 << 20
+
+	// The witness shape: a build whose IN-MEMORY footprint overflows the
+	// budget while its ON-DISK footprint would fit several times over. This is
+	// the case that separates the two models, and it is the case a calibration
+	// applied inside the byte model would have silently de-spilled.
+	const rows, ncols = 242450.0, 30
+	if got := rows * hashsize.EntryBytes(ncols, 0); !(got > float64(cp.workMem)) {
+		t.Fatalf("witness is not a spilling shape in memory: %.0f bytes vs budget %d", got, cp.workMem)
+	}
+	if got := rows * hashsize.SpillInnerBytes(ncols, 0); !(got < float64(cp.workMem)) {
+		t.Fatalf("witness does not separate the models: %.0f on-disk bytes vs budget %d", got, cp.workMem)
+	}
+	if got := hashsize.Choose(rows, ncols, 0, cp.workMem).NBatch; got <= 1 {
+		t.Fatalf("Choose says NBatch = %d — the spill decision followed the on-disk model", got)
+	}
+
+	in := hashJoinInputs{
+		outerRows: 1500000, innerRows: rows, outputRows: rows,
+		numHashClauses: 1, outerCols: 9, innerCols: ncols,
+	}
+	spilled := hashJoinCost(cp, in)
+	// Same shape, one batch: strip the term by fitting the build, and the
+	// difference must be exactly the derived page charge.
+	fitting := in
+	fitting.innerCols = 2
+	if got := hashsize.Choose(fitting.innerRows, fitting.innerCols, 0, cp.workMem).NBatch; got != 1 {
+		t.Fatalf("control shape batches (%d) — pick a narrower one", got)
+	}
+	want := cp.seqPageCost * (2*spillPagesInner(rows, ncols, 0) + 2*spillPagesOuter(1500000, 9, 0))
+	// The control's own CPU terms differ only in the build width, which
+	// hashJoinCost does not read, so the totals differ by the batch term alone.
+	if got := spilled.Total - hashJoinCost(cp, fitting).Total; math.Abs(got-want) > 1 {
+		t.Errorf("batch term = %.0f, want %.0f — the charge is not the derived model", got, want)
+	}
+}
