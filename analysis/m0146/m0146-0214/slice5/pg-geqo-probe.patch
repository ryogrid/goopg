+/* M0146-0214 slice 3 probe: trace the join rels of one evaluation. */
+int			geqo_probe_seq = 0;
+static bool geqo_probe_this = false;
+
+static void
+geqo_probe_join(RelOptInfo *joinrel)
+{
+	Path	   *p = joinrel->cheapest_total_path;
+	const char *outer = "-", *inner = "-";
+
+	if (!geqo_probe_this || p == NULL)
+		return;
+	{
+		ListCell   *lc;
+
+		foreach(lc, joinrel->partial_pathlist)
+		{
+			Path	   *pp = (Path *) lfirst(lc);
+
+			elog(LOG, "GEQOPARTIAL relids=%s type=%d startup=%.6f total=%.6f rows=%.0f pk=%d workers=%d",
+				 bmsToString(joinrel->relids), (int) pp->pathtype, pp->startup_cost, pp->total_cost,
+				 pp->rows, list_length(pp->pathkeys), pp->parallel_workers);
+			if (IsA(pp, NestPath) || IsA(pp, MergePath) || IsA(pp, HashPath))
+			{
+				JoinPath   *jp = (JoinPath *) pp;
+
+				elog(LOG, "GEQOPARTIALKIDS outer=%s:%d:%.6f..%.6f:r%.0f:pk%d:ps%d:w%d inner=%s:%d:%.6f..%.6f:r%.0f:pk%d:ps%d",
+					 bmsToString(jp->outerjoinpath->parent->relids), (int) jp->outerjoinpath->pathtype,
+					 jp->outerjoinpath->startup_cost, jp->outerjoinpath->total_cost, jp->outerjoinpath->rows,
+					 list_length(jp->outerjoinpath->pathkeys), (int) jp->outerjoinpath->parallel_safe, jp->outerjoinpath->parallel_workers,
+					 bmsToString(jp->innerjoinpath->parent->relids), (int) jp->innerjoinpath->pathtype,
+					 jp->innerjoinpath->startup_cost, jp->innerjoinpath->total_cost, jp->innerjoinpath->rows,
+					 list_length(jp->innerjoinpath->pathkeys), (int) jp->innerjoinpath->parallel_safe);
+				if (IsA(pp, MergePath))
+					elog(LOG, "GEQOPARTIALMERGE outersort=%d innersort=%d materialize=%d",
+						 list_length(((MergePath *) pp)->outersortkeys), list_length(((MergePath *) pp)->innersortkeys),
+						 (int) ((MergePath *) pp)->materialize_inner);
+			}
+		}
+		foreach(lc, joinrel->pathlist)
+		{
+			Path	   *pp = (Path *) lfirst(lc);
+
+			elog(LOG, "GEQOPATH relids=%s type=%d startup=%.6f total=%.6f rows=%.0f pk=%d",
+				 bmsToString(joinrel->relids), (int) pp->pathtype, pp->startup_cost, pp->total_cost,
+				 pp->rows, list_length(pp->pathkeys));
+		}
+	}
+	if (IsA(p, NestPath) || IsA(p, MergePath) || IsA(p, HashPath))
+	{
+		JoinPath   *jp = (JoinPath *) p;
+
+		outer = bmsToString(jp->outerjoinpath->parent->relids);
+		inner = bmsToString(jp->innerjoinpath->parent->relids);
+	}
+	elog(LOG, "GEQOJOIN relids=%s rows=%.0f type=%d startup=%.6f total=%.6f outer=%s inner=%s",
+		 bmsToString(joinrel->relids), joinrel->rows, (int) p->pathtype,
+		 p->startup_cost, p->total_cost, outer, inner);
+	if (IsA(p, NestPath) || IsA(p, MergePath) || IsA(p, HashPath))
+	{
+		JoinPath   *jp = (JoinPath *) p;
+		Path	   *op = jp->outerjoinpath,
+				   *ip = jp->innerjoinpath;
+
+		elog(LOG, "GEQOJOINKIDS outer=%d:%.6f..%.6f:r%.0f:pk%d inner=%d:%.6f..%.6f:r%.0f:pk%d",
+			 (int) op->pathtype, op->startup_cost, op->total_cost, op->rows, list_length(op->pathkeys),
+			 (int) ip->pathtype, ip->startup_cost, ip->total_cost, ip->rows, list_length(ip->pathkeys));
+		if (IsA(p, MergePath))
+		{
+			MergePath  *mp = (MergePath *) p;
+
+			elog(LOG, "GEQOMERGE clauses=%d outersort=%d innersort=%d materialize=%d skipmark=%d presorted_outer=%d",
+				 list_length(mp->path_mergeclauses), list_length(mp->outersortkeys), list_length(mp->innersortkeys),
+				 (int) mp->materialize_inner, (int) mp->skip_mark_restore, mp->outer_presorted_keys);
+		}
+	}
+}
