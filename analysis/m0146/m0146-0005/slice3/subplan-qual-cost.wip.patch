diff --git a/internal/optimizer/subplan_cost.go b/internal/optimizer/subplan_cost.go
index f9fca5e6c..6c3cc44c4 100644
--- a/internal/optimizer/subplan_cost.go
+++ b/internal/optimizer/subplan_cost.go
@@ -123,3 +123,99 @@ func matchSetByColumnName(tbl *catalog.Table, col string) int64 {
 	}
 	return 0
 }
+
+// subPlanQualPerTuple is the per-evaluation cost `cost_qual_eval` charges for
+// the SubPlans in one qual expression (costsize.c cost_qual_eval_walker's
+// SubPlan arm, with the numbers `cost_subplan` stored on the node):
+//
+//   - a CORRELATED sublink re-runs per evaluation and re-pays its startup
+//     (its parParam is non-empty, so "pay the startup cost every time"):
+//     EXPR/ARRAY charge the plan's run cost, EXISTS the run cost for one row
+//     (run / rows), ANY/ALL half the run plus half the rows at
+//     cpu_operator_cost — each plus the plan's startup cost;
+//   - an UNCORRELATED sublink is an InitPlan (EXPR/EXISTS/ARRAY) or a hashed
+//     SubPlan (ANY/ALL) in PG: evaluated once, so nothing per tuple.
+//
+// The sublink's plan cost is read with legacyDisplayCostOf — the search's
+// numbers where the node carries them, else the same derivation EXPLAIN
+// renders — from under a non-isolated Project, which PG folds into the plan
+// below it. Nested sublinks inside the SubPlan's own plan are that plan's
+// business and are not descended into (M0146-0005 slice 3: TPC-H Q17's
+// correlated `l_quantity < (SELECT 0.2 * avg(...))` made a nested loop that
+// runs it ~5,940 times look cheaper than PG's hash join, which runs it 10).
+func subPlanQualPerTuple(cp costParams, e Expr) float64 {
+	total := 0.0
+	walkExprRefs(e, scopeSignal, exprVisitor{Visit: func(n Expr) bool {
+		if x, ok := n.(*SubqueryExpr); ok && !sublinkIsUncorrelated(x.Plan, x.Args, x.ParParam) {
+			total += correlatedSubPlanCallCost(cp, x.Plan, sublinkExpr)
+		}
+		if x, ok := n.(*ArraySubqueryExpr); ok && x.Plan != nil && !x.IsNonCorrelated && planHasOuterRef(x.Plan) {
+			total += correlatedSubPlanCallCost(cp, x.Plan, sublinkExpr)
+		}
+		if x, ok := n.(*ExistsExpr); ok && !sublinkIsUncorrelated(x.Plan, x.Args, x.ParParam) {
+			total += correlatedSubPlanCallCost(cp, x.Plan, sublinkExists)
+		}
+		if x, ok := n.(*InExpr); ok && x.Plan != nil && !sublinkIsUncorrelated(x.Plan, x.Args, x.ParParam) {
+			total += correlatedSubPlanCallCost(cp, x.Plan, sublinkAnyAll)
+		}
+		return true
+	}})
+	return total
+}
+
+type sublinkCostKind int
+
+const (
+	sublinkExpr sublinkCostKind = iota
+	sublinkExists
+	sublinkAnyAll
+)
+
+// correlatedSubPlanCallCost is cost_subplan's non-hashed arm for a correlated
+// SubPlan: the per-call cost including the re-paid startup.
+func correlatedSubPlanCallCost(cp costParams, plan Node, kind sublinkCostKind) float64 {
+	if plan == nil {
+		return 0
+	}
+	if p, ok := plan.(*Project); ok && !p.IsolatedScope && p.Child != nil {
+		plan = p.Child
+	}
+	pc := legacyDisplayCostOf(plan)
+	run := pc.TotalCost - pc.StartupCost
+	if run < 0 {
+		run = 0
+	}
+	rows := clampRowEst(pc.PlanRows)
+	var perCall float64
+	switch kind {
+	case sublinkExists:
+		perCall = run / rows
+	case sublinkAnyAll:
+		perCall = 0.50*run + 0.50*pc.PlanRows*cp.cpuOperatorCost
+	default:
+		perCall = run
+	}
+	return perCall + pc.StartupCost
+}
+
+// joinQualPerTuple is `qp_qual_cost.per_tuple` for a join's residual quals:
+// goopg's flat cpu_operator_cost per conjunct plus the correlated SubPlans'
+// per-evaluation cost.
+func joinQualPerTuple(cp costParams, quals []*restrictInfo) float64 {
+	per := cp.cpuOperatorCost * float64(len(quals))
+	for _, ri := range quals {
+		if ri != nil {
+			per += subPlanQualPerTuple(cp, ri.clause)
+		}
+	}
+	return per
+}
+
+// joinQualEvalCost is qualEvalCost for a join's residual restrictInfos,
+// including the correlated SubPlans' per-evaluation cost.
+func joinQualEvalCost(cp costParams, quals []*restrictInfo, tuples float64) float64 {
+	if len(quals) == 0 || !(tuples > 0) {
+		return 0
+	}
+	return joinQualPerTuple(cp, quals) * tuples
+}
