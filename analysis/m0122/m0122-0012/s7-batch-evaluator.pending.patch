+// evalFastBinaryApply is the BinaryOp arm's work once both operands are in
+// hand: the character-string comparison, pg_lsn arithmetic, the bpchar and
+// concat operand coercions, evalBinary / evalConcat and the int2/int4
+// overflow checks. The per-row arm and evalFastExprBatch both call it, so the
+// two agree element for element by construction (M0122-0012).
+func evalFastBinaryApply(n *ExprNode, op parser.OpCode, lp, rp *Datum, ctx *Context, out *Datum) error {
+	var err error
+	left, right := *lp, *rp
+	// The compiled position (payload[4:8]), not a literal 0: every error
+	// these three helpers raise is stamped with it on the interpreted twin.
+	// M0127-PS6.2.
+	pos := int(int32(binary.LittleEndian.Uint32(n.payload[4:])))
+	if n.payload[16]&4 != 0 && textShapeAmbiguous(left, right) {
+		*out = binaryTextComparison(op, left, right,
+			int64(binary.LittleEndian.Uint32(n.payload[8:])), int64(binary.LittleEndian.Uint32(n.payload[12:])),
+			n.payload[16]&1 != 0, n.payload[16]&2 != 0)
+		return nil
+	}
+	// pg_lsn arithmetic: detect before evalBinary (mirrors evalExprSlot). M0097-pg_lsn.
+	if (left.Kind == KindString && looksLikePgLSN(left.StringValue())) ||
+		(right.Kind == KindString && looksLikePgLSN(right.StringValue())) {
+		res, handled, lsnErr := evalPgLSNBinary(op, left, right, pos)
+		if lsnErr != nil {
+			return lsnErr
+		}
+		if handled {
+			*out = res
+			return nil
+		}
+	}
+	lbp := int64(binary.LittleEndian.Uint32(n.payload[8:]))
+	rbp := int64(binary.LittleEndian.Uint32(n.payload[12:]))
+	// M0122-0012: both helpers return their operands unchanged unless
+	// their own preconditions hold (a concat; a bpchar-typed side), so
+	// those preconditions are tested here first. A scan qual's numeric
+	// or integer comparison then skips two calls that each copy four
+	// Datums: about 9% of a filtered TPC-DS store_sales scan.
+	if op == parser.OpConcat {
+		left, right = concatOperandsAsText(op, left, right, lbp, rbp)
+	}
+	if lbp > 0 || rbp > 0 {
+		left, right = comparisonOperandsAsBpchar(op, left, right, lbp, rbp,
+			n.payload[16]&1 != 0, n.payload[16]&2 != 0)
+	}
+	var result Datum
+	if op == parser.OpConcat {
+		mode := concatGuess
+		switch {
+		case n.payload[16]&8 != 0:
+			mode = concatText
+		case n.payload[16]&16 != 0:
+			mode = concatJSONB
+		case n.payload[16]&32 != 0:
+			mode = concatArrayCat
+		case n.payload[16]&64 != 0:
+			mode = concatArrayAppend
+		case n.payload[16]&128 != 0:
+			mode = concatArrayPrepend
+		}
+		result, err = evalConcat(left, right, pos, ctx, mode)
+	} else {
+		result, err = evalBinary(op, left, right, pos, ctx)
+	}
+	if err != nil {
+		return err
+	}
+	// Integer-overflow check, mirroring evalExprSlot. The fast path
+	// previously skipped this, silently returning out-of-range int2/int4
+	// arithmetic results. M0097 regression fix.
+	//
+	// No Pos on either raise site: this mirrors expr.go's evalExprSlot
+	// BinaryOp overflow check (interpreted twin) — int2pl/int4pl etc.
+	// (postgres/src/backend/utils/adt/int.c) never call errposition, so
+	// PG never attaches LINE-context to a runtime arithmetic overflow
+	// regardless of whether an operand was a literal or a column.
+	// M0134-0070; the interpreted twin was fixed in the same round —
+	// leaving only one twin Pos-less would silently reintroduce the
+	// sibling divergence M0127-PS6.2 fixed.
+	if err := fastIntOverflow(n, &result); err != nil {
+		return err
+	}
+	*out = result
+	return nil
+}
+
+// fastBinarySimple reports that every preamble branch of evalFastBinaryApply
+// is a no-op for these operands: no ambiguous character-string comparison,
+// no string operand (the pg_lsn probe), not a concat, no bpchar-typed side.
+// The BinaryOp result is then evalBinary's plus fastIntOverflow, which is
+// what the per-row arm computes inline.
+func fastBinarySimple(n *ExprNode, op parser.OpCode, left, right *Datum) bool {
+	return n.payload[16]&4 == 0 && left.Kind != KindString && right.Kind != KindString &&
+		op != parser.OpConcat && binary.LittleEndian.Uint64(n.payload[8:16]) == 0
+}
+
+// fastIntOverflow is the int2/int4 overflow check shared by the per-row
+// BinaryOp arm and evalFastBinaryApply.
+//
+// No Pos on either raise site: this mirrors expr.go's evalExprSlot BinaryOp
+// overflow check (the interpreted twin). int2pl/int4pl etc.
+// (postgres/src/backend/utils/adt/int.c) never call errposition, so PG never
+// attaches LINE context to a runtime arithmetic overflow, whether an operand
+// was a literal or a column. M0134-0070.
+func fastIntOverflow(n *ExprNode, result *Datum) error {
+	if result.Kind == KindInt {
+		switch n.payload[1] {
+		case ovfInt2:
+			if result.Int < -32768 || result.Int > 32767 {
+				return &ExecError{Code: "22003", Message: "smallint out of range"}
+			}
+		case ovfInt4:
+			if result.Int < -2147483648 || result.Int > 2147483647 {
+				return &ExecError{Code: "22003", Message: "integer out of range"}
+			}
+		}
+	}
+	return nil
+}
+
 // exprFoldable reports whether e can be evaluated once at build time and
 // replaced by its value — i.e. it reads no column and is deterministic.
 //
diff --git a/internal/executor/exprnode_batch.go b/internal/executor/exprnode_batch.go
new file mode 100644
index 000000000..1eff6c0f8
--- /dev/null
+++ b/internal/executor/exprnode_batch.go
@@ -0,0 +1,193 @@
+package executor
+
+import (
+	"encoding/binary"
+	"fmt"
+
+	"github.com/goopg/goopg/internal/parser"
+)
+
+// evalFastExprBatch is evalFastExpr over many rows at once (M0122-0012; design
+// docs/design/0100-0149/0122-0012b-scan-batch-qual.md).
+//
+// It evaluates exprs[idx] for each row rows[sel[k]] and writes the result to
+// out[k]. views[i] is a SlotView over rows[i], boxed once by the caller, so the
+// generic arm can hand evalFastExpr a slot without allocating per row.
+//
+// The point is the tree walk: evalFastExpr dispatches every node once per row,
+// and after slices 2-5 that dispatch was the largest remaining cost of a
+// filtered scan (slice 6). Here each node is dispatched once per batch and its
+// per-row work is a tight loop.
+//
+// Semantics are evalFastExpr's, element for element:
+//
+//   - Leaves (column refs, constants) produce exactly the Datum evalFastExpr
+//     returns. A column ref out of range is not handled here; it returns an
+//     error so the caller re-evaluates per row and gets evalFastExpr's exact
+//     error.
+//   - BinaryOp calls evalFastBinaryApply, the same function the per-row arm
+//     calls. AND/OR evaluate the right operand only on rows whose left value
+//     the per-row arm would not short-circuit (Kind == KindBool and false for
+//     AND, true for OR). So a right side that would raise on a short-circuited
+//     row is never evaluated for it, as per row.
+//   - Every other kind is evaluated per row through evalFastExpr itself.
+//
+// Errors: the first error encountered is returned and out is then undefined.
+// The batch evaluates node by node, not row by row, so which row's error comes
+// first can differ from the per-row order. Callers therefore treat any error as
+// "re-evaluate this batch per row", which raises the per-row path's error at
+// the per-row path's row. That is sound only because the expressions callers
+// admit are pure (the scan prefilter's PlanScanQual excludes functions,
+// subqueries and params), so an abandoned batch attempt has no side effects.
+func evalFastExprBatch(exprs exprTreeSlab, idx int32, rows []Row, views []SlotView, sel []int32, ctx *Context, sc *exprBatchScratch, out []Datum) error {
+	out = out[:len(sel)]
+	if idx == noExpr {
+		for k := range out {
+			out[k] = NullDatum
+		}
+		return nil
+	}
+	n := &exprs[idx]
+	switch n.Kind {
+	case ExprConstVal:
+		v := *n.constVal
+		for k := range out {
+			out[k] = v
+		}
+		return nil
+
+	case ExprIntConst:
+		v := Datum{Kind: KindInt, Int: int64(binary.LittleEndian.Uint64(n.payload[:]))}
+		for k := range out {
+			out[k] = v
+		}
+		return nil
+
+	case ExprBoolConst:
+		v := NewBoolDatum(n.payload[0] != 0)
+		for k := range out {
+			out[k] = v
+		}
+		return nil
+
+	case ExprNullConst:
+		for k := range out {
+			out[k] = NullDatum
+		}
+		return nil
+
+	case ExprColumnRef:
+		colIdx := int(int32(binary.LittleEndian.Uint32(n.payload[:])))
+		for k, r := range sel {
+			row := rows[r]
+			if colIdx < 0 || colIdx >= len(row) {
+				return fmt.Errorf("executor: evalFastExprBatch: column %d out of row width %d", colIdx, len(row))
+			}
+			checkDeformPoison(row[colIdx])
+			out[k] = row[colIdx]
+		}
+		return nil
+
+	case ExprBinaryOp:
+		if n.childA == noExpr || n.childB == noExpr {
+			return fmt.Errorf("executor: evalFastExprBatch: BinaryOp node %d missing child", idx)
+		}
+		op := parser.OpCode(n.payload[0])
+		left := sc.push(len(sel))
+		defer sc.pop()
+		if err := evalFastExprBatch(exprs, n.childA, rows, views, sel, ctx, sc, left); err != nil {
+			return err
+		}
+		if op == parser.OpAnd || op == parser.OpOr {
+			// The rows the per-row arm would evaluate the right side for.
+			// pos[j] is the position in sel/out of the j-th such row.
+			short := op == parser.OpOr
+			sub := sc.pushSel(len(sel))
+			pos := sc.pushSel(len(sel))
+			defer sc.popSel(2)
+			sub, pos = sub[:0], pos[:0]
+			for k, l := range left {
+				if l.Kind == KindBool && l.BoolValue() == short {
+					out[k] = l
+					continue
+				}
+				sub = append(sub, sel[k])
+				pos = append(pos, int32(k))
+			}
+			if len(sub) == 0 {
+				return nil
+			}
+			right := sc.push(len(sub))
+			defer sc.pop()
+			if err := evalFastExprBatch(exprs, n.childB, rows, views, sub, ctx, sc, right); err != nil {
+				return err
+			}
+			for j, k := range pos {
+				if err := evalFastBinaryApply(n, op, &left[k], &right[j], ctx, &out[k]); err != nil {
+					return err
+				}
+			}
+			return nil
+		}
+		right := sc.push(len(sel))
+		defer sc.pop()
+		if err := evalFastExprBatch(exprs, n.childB, rows, views, sel, ctx, sc, right); err != nil {
+			return err
+		}
+		for k := range out {
+			if err := evalFastBinaryApply(n, op, &left[k], &right[k], ctx, &out[k]); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+
+	// Every other kind (UnaryOp, ExprAdapter, ...): per row, through the
+	// per-row evaluator itself.
+	for k, r := range sel {
+		v, err := evalFastExpr(exprs, idx, views[r], ctx)
+		if err != nil {
+			return err
+		}
+		out[k] = v
+	}
+	return nil
+}
+
+// exprBatchScratch is evalFastExprBatch's operand storage: a stack of Datum
+// vectors and selection vectors, one frame per BinaryOp level being evaluated,
+// reused across batches so a steady-state scan allocates nothing.
+type exprBatchScratch struct {
+	datums [][]Datum
+	dTop   int
+	sels   [][]int32
+	sTop   int
+}
+
+func (sc *exprBatchScratch) push(n int) []Datum {
+	if sc.dTop == len(sc.datums) {
+		sc.datums = append(sc.datums, nil)
+	}
+	if cap(sc.datums[sc.dTop]) < n {
+		sc.datums[sc.dTop] = make([]Datum, n)
+	}
+	v := sc.datums[sc.dTop][:n]
+	sc.dTop++
+	return v
+}
+
+func (sc *exprBatchScratch) pop() { sc.dTop-- }
+
+func (sc *exprBatchScratch) pushSel(n int) []int32 {
+	if sc.sTop == len(sc.sels) {
+		sc.sels = append(sc.sels, nil)
+	}
+	if cap(sc.sels[sc.sTop]) < n {
+		sc.sels[sc.sTop] = make([]int32, n)
+	}
+	v := sc.sels[sc.sTop][:n]
+	sc.sTop++
+	return v
+}
+
+func (sc *exprBatchScratch) popSel(k int) { sc.sTop -= k }
diff --git a/internal/executor/exprnode_batch_test.go b/internal/executor/exprnode_batch_test.go
new file mode 100644
index 000000000..8124bcfb4
--- /dev/null
+++ b/internal/executor/exprnode_batch_test.go
@@ -0,0 +1,175 @@
+package executor
+
+import (
+	"math/rand"
+	"reflect"
+	"testing"
+
+	"github.com/goopg/goopg/internal/optimizer"
+	"github.com/goopg/goopg/internal/parser"
+)
+
+// TestEvalFastExprBatchMatchesPerRow is evalFastExprBatch's sibling check
+// (M0122-0012). For every expression and every random selection it must give
+// exactly the per-row evaluator's Datum on each selected row. When the per-row
+// pass raises on any selected row, the batch must also raise: callers then
+// re-run the batch per row, which is what makes its node-at-a-time error order
+// acceptable. The batch must NOT raise when no selected row raises. The AND/OR
+// cases are built so that a right side evaluated on a short-circuited row would
+// divide by zero; that pins the selection-vector short circuit.
+func TestEvalFastExprBatchMatchesPerRow(t *testing.T) {
+	col := func(i int) optimizer.Expr { return &optimizer.ColumnRef{Index: i} }
+	ic := func(v int64) optimizer.Expr { return &optimizer.IntegerConst{Value: v} }
+	bin := func(op parser.OpCode, l, r optimizer.Expr) optimizer.Expr {
+		return &optimizer.BinaryOp{Op: op, Left: l, Right: r}
+	}
+	// Columns: 0 int (may be 0 or NULL), 1 numeric, 2 string, 3 bool (or
+	// NULL), 4 int near the int4 limit.
+	exprs := map[string]optimizer.Expr{
+		"eq":          bin(parser.OpEq, col(0), ic(3)),
+		"lt-numeric":  bin(parser.OpLt, col(1), ic(10)),
+		"ge-numconst": bin(parser.OpGe, col(1), &optimizer.NumericConst{Value: "5.25"}),
+		"between":     bin(parser.OpAnd, bin(parser.OpGe, col(0), ic(1)), bin(parser.OpLe, col(0), ic(4))),
+		"and-guard": bin(parser.OpAnd, bin(parser.OpNe, col(0), ic(0)),
+			bin(parser.OpGt, bin(parser.OpDiv, ic(12), col(0)), ic(2))),
+		"or-guard": bin(parser.OpOr, bin(parser.OpEq, col(0), ic(0)),
+			bin(parser.OpGt, bin(parser.OpDiv, ic(12), col(0)), ic(2))),
+		"unguarded-div": bin(parser.OpGt, bin(parser.OpDiv, ic(12), col(0)), ic(2)),
+		"and-chain": bin(parser.OpAnd, bin(parser.OpAnd, bin(parser.OpGe, col(0), ic(1)), bin(parser.OpLt, col(1), ic(50))),
+			bin(parser.OpNe, col(2), &optimizer.StringConst{Value: "b"})),
+		"bool-col-and":  bin(parser.OpAnd, col(3), bin(parser.OpGt, col(0), ic(2))),
+		"bool-col-or":   bin(parser.OpOr, col(3), bin(parser.OpGt, col(0), ic(2))),
+		"null-and":      bin(parser.OpAnd, &optimizer.NullConst{}, bin(parser.OpGt, col(0), ic(2))),
+		"string-lt":     bin(parser.OpLt, col(2), &optimizer.StringConst{Value: "c"}),
+		"arith-cmp":     bin(parser.OpGt, bin(parser.OpAdd, col(0), col(1)), ic(7)),
+		"int4-overflow": bin(parser.OpGt, bin(parser.OpMul, col(4), ic(4)), ic(0)),
+		"unary-neg":     bin(parser.OpLt, &optimizer.UnaryOp{Op: parser.OpUnaryNeg, Operand: col(0)}, ic(-2)),
+		"not":           &optimizer.UnaryOp{Op: parser.OpNot, Operand: bin(parser.OpGt, col(0), ic(2))},
+		"bare-col":      col(1),
+		"const-only":    bin(parser.OpLt, ic(1), ic(2)),
+	}
+	rng := rand.New(rand.NewSource(122012))
+	strs := []string{"a", "b", "c", "d"}
+	mkRows := func(n int, withZero bool) []Row {
+		rows := make([]Row, n)
+		for i := range rows {
+			v0 := NewIntDatum(int64(rng.Intn(6)))
+			if !withZero && v0.Int == 0 {
+				v0 = NewIntDatum(1)
+			}
+			if rng.Intn(9) == 0 {
+				v0 = NullDatum
+			}
+			v3 := NewBoolDatum(rng.Intn(2) == 0)
+			if rng.Intn(7) == 0 {
+				v3 = NullDatum
+			}
+			v4 := NewIntDatum(int64(rng.Intn(1000)))
+			if rng.Intn(25) == 0 {
+				v4 = NewIntDatum(2147483000)
+			}
+			rows[i] = Row{v0, Datum{Kind: KindNumeric, Int: int64(rng.Intn(10000)), Scale: 2}, NewStringDatum(strs[rng.Intn(len(strs))]), v3, v4}
+		}
+		return rows
+	}
+	var sc exprBatchScratch
+	for name, e := range exprs {
+		var slab exprTreeSlab
+		idx := slab.buildExpr(e)
+		for trial := 0; trial < 40; trial++ {
+			rows := mkRows(1+rng.Intn(80), trial%3 != 0)
+			views := make([]SlotView, len(rows))
+			for i := range rows {
+				views[i] = rowSlotView(rows[i])
+			}
+			var sel []int32
+			for i := range rows {
+				if trial%2 == 0 || rng.Intn(3) != 0 {
+					sel = append(sel, int32(i))
+				}
+			}
+			want := make([]Datum, len(sel))
+			var wantErr error
+			for k, r := range sel {
+				v, err := evalFastExpr(slab, idx, views[r], nil)
+				if err != nil {
+					wantErr = err
+					break
+				}
+				want[k] = v
+			}
+			got := make([]Datum, len(sel))
+			gotErr := evalFastExprBatch(slab, idx, rows, views, sel, nil, &sc, got)
+			if sc.dTop != 0 || sc.sTop != 0 {
+				t.Fatalf("%s: scratch stack not balanced: datums=%d sels=%d", name, sc.dTop, sc.sTop)
+			}
+			if (wantErr != nil) != (gotErr != nil) {
+				t.Fatalf("%s trial %d: per-row err=%v, batch err=%v", name, trial, wantErr, gotErr)
+			}
+			if wantErr != nil {
+				continue
+			}
+			for k := range sel {
+				if !reflect.DeepEqual(got[k], want[k]) {
+					t.Fatalf("%s trial %d row %d: batch %#v, per-row %#v (row %v)", name, trial, sel[k], got[k], want[k], rows[sel[k]])
+				}
+			}
+		}
+	}
+}
+
+// benchStoreSalesQual is the filtered TPC-DS store_sales qual the M0122-0012
+// slices were measured on: an int column BETWEEN two constants, and two numeric
+// columns against integer constants (the cross-kind comparison).
+func benchStoreSalesQual() (exprTreeSlab, int32, []Row, []SlotView) {
+	col := func(i int) optimizer.Expr { return &optimizer.ColumnRef{Index: i} }
+	ic := func(v int64) optimizer.Expr { return &optimizer.IntegerConst{Value: v} }
+	bin := func(op parser.OpCode, l, r optimizer.Expr) optimizer.Expr {
+		return &optimizer.BinaryOp{Op: op, Left: l, Right: r}
+	}
+	e := bin(parser.OpAnd,
+		bin(parser.OpAnd,
+			bin(parser.OpAnd, bin(parser.OpGe, col(0), ic(1)), bin(parser.OpLe, col(0), ic(20))),
+			bin(parser.OpGt, col(1), ic(10))),
+		bin(parser.OpLt, col(2), ic(500)))
+	var slab exprTreeSlab
+	idx := slab.buildExpr(e)
+	rng := rand.New(rand.NewSource(1))
+	rows := make([]Row, filterBatchSize)
+	views := make([]SlotView, len(rows))
+	for i := range rows {
+		rows[i] = Row{NewIntDatum(int64(1 + rng.Intn(100))),
+			Datum{Kind: KindNumeric, Int: int64(rng.Intn(20000)), Scale: 2},
+			Datum{Kind: KindNumeric, Int: int64(rng.Intn(100000)), Scale: 2}}
+		views[i] = rowSlotView(rows[i])
+	}
+	return slab, idx, rows, views
+}
+
+func BenchmarkStoreSalesQualPerRow(b *testing.B) {
+	slab, idx, _, views := benchStoreSalesQual()
+	b.ResetTimer()
+	for i := 0; i < b.N; i++ {
+		for _, v := range views {
+			if _, err := evalFastExpr(slab, idx, v, nil); err != nil {
+				b.Fatal(err)
+			}
+		}
+	}
+}
+
+func BenchmarkStoreSalesQualBatch(b *testing.B) {
+	slab, idx, rows, views := benchStoreSalesQual()
+	sel := make([]int32, len(rows))
+	for i := range sel {
+		sel[i] = int32(i)
+	}
+	out := make([]Datum, len(rows))
+	var sc exprBatchScratch
+	b.ResetTimer()
+	for i := 0; i < b.N; i++ {
+		if err := evalFastExprBatch(slab, idx, rows, views, sel, nil, &sc, out); err != nil {
+			b.Fatal(err)
+		}
+	}
+}
