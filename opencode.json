{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "./.opencode/plugins/no-background-shell.ts",
    "./.opencode/plugins/ralph-guards.ts"
  ],
  "provider": {
    "bai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "B.AI",
      "options": {
        "baseURL": "https://api.b.ai/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        }
      }
    },
    "strata": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Strata (local)",
      "options": {
        "baseURL": "http://192.168.56.1:8080/v1",
        "apiKey": "local"
      },
      "models": {
        "qwen3.8-flash-next-coder": {
          "name": "Qwen3.8-Flash-Next Coder (Strata)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "qwen3.8-flash-next-swift": {
          "name": "Qwen3.8-Flash-Next Swift IQ3_S Q4_0 256k (Strata)",
          "limit": {
            "context": 262144,
            "output": 8192
          }
        }
      }
    },
   "opencode": {
     "models": {
       "muse-spark-1.3-contributor-free": {
       	"name": "Muse Spark 1.3 free"
       }
     }
   }
  },
  "mcp": {
    "serena": {
      "type": "local",
      "enabled": true,
      "command": [
        "uv",
        "run",
        "--directory",
        "/home/ryo/work/goopg/goopg/serena",
        "serena",
        "start-mcp-server",
        "--context=ide",
        "--project",
        "/home/ryo/work/goopg/goopg"
      ]
    }
  }
}
