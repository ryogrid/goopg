{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "./.opencode/plugins/no-background-shell.ts"
  ],
  "provider": {
    "bai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "B.AI",
      "options": {
        "baseURL": "https://api.b.ai/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        }
      }
    },
   "opencode": {
     "models": {
       "muse-spark-1.3-contributor-free": {
       	"name": "Muse Spark 1.3 free"
       }
     }
   }
  },
  "mcp": {
    "serena": {
      "type": "local",
      "enabled": true,
      "command": [
        "uv",
        "run",
        "--directory",
        "/home/ryo/work/goopg/goopg/serena",
        "serena",
        "start-mcp-server",
        "--context=ide",
        "--project",
        "/home/ryo/work/goopg/goopg"
      ]
    }
  }
}
