{
  "permissions": {
    "allow": [
      "Bash(wp/verification/reset_wp_schema.sh)",
      "Bash(bash wp/verification/reset_wp_schema.sh)",
      "Bash(xargs -I{} basename {} .sql)",
      "Bash(systemctl --user stop goopg-wp.scope)",
      "Bash(systemctl --user reset-failed goopg-wp.scope)"
    ]
  },
  "env": {
    "BASH_MAX_TIMEOUT_MS": "3600000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --directory /home/ryo/work/goopg/goopg/serena serena-hooks remind --client=claude-code"
          }
        ]
      },
      {
        "matcher": "mcp__serena__*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --directory /home/ryo/work/goopg/goopg/serena serena-hooks auto-approve --client=claude-code"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --directory /home/ryo/work/goopg/goopg/serena serena-hooks activate --client=claude-code"
          },
          {
            "type": "command",
            "command": "python3 /home/ryo/work/goopg/goopg/analysis/ralph-loop-kaizen/practice-cards/concurrency_guard.py 2>/dev/null"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/ryo/work/goopg/goopg/analysis/ralph-loop-kaizen/practice-cards/route.py 2>/dev/null"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --directory /home/ryo/work/goopg/goopg/serena serena-hooks cleanup --client=claude-code"
          },
          {
            "type": "command",
            "command": "python3 /home/ryo/work/goopg/goopg/analysis/ralph-loop-kaizen/practice-cards/bg_task_guard.py",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "serena"
  ]
}
